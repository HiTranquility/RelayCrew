{
  "name": "ai-team-workbench",
  "displayName": "RelayCrew",
  "description": "%description%",
  "version": "0.9.7",
  "publisher": "local-ai-team",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "node scripts/ui-smoke.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "node scripts/package.mjs",
    "preview": "tsx scripts/preview.ts",
    "releases:verify": "node scripts/releases.mjs verify",
    "release:stage": "node scripts/releases.mjs stage"
  },
  "dependencies": {
    "cron-parser": "^5.4.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "aiTeam.newTask",
        "title": "%command.newTask%",
        "icon": "$(add)"
      },
      {
        "command": "aiTeam.schedule",
        "title": "%command.schedule%"
      },
      {
        "command": "aiTeam.switch",
        "title": "%command.switch%"
      },
      {
        "command": "aiTeam.profiles",
        "title": "%command.profiles%"
      },
      {
        "command": "aiTeam.secret",
        "title": "%command.secret%"
      },
      {
        "command": "aiTeam.quota",
        "title": "%command.quota%"
      },
      {
        "command": "aiTeam.report",
        "title": "%command.report%"
      },
      {
        "command": "aiTeam.cancel",
        "title": "%command.cancel%"
      },
      {
        "command": "aiTeam.pauseSchedule",
        "title": "%command.pauseSchedule%"
      },
      {
        "command": "aiTeam.logs",
        "title": "%command.logs%"
      },
      {
        "command": "aiTeam.settings",
        "title": "%command.settings%"
      },
      {
        "command": "aiTeam.connections",
        "title": "%command.connections%"
      },
      {
        "command": "aiTeam.board",
        "title": "%command.board%",
        "icon": "$(preview)"
      },
      {
        "command": "aiTeam.reply",
        "title": "%command.reply%"
      },
      {
        "command": "aiTeam.backlog",
        "title": "%command.backlog%"
      },
      {
        "command": "aiTeam.utilization",
        "title": "%command.utilization%"
      },
      {
        "command": "aiTeam.flow",
        "title": "%command.flow%"
      },
      {
        "command": "aiTeam.accountDetails",
        "title": "%command.accountDetails%"
      },
      {
        "command": "aiTeam.resume",
        "title": "%command.resume%"
      },
      {
        "command": "aiTeam.backups",
        "title": "%command.backups%"
      },
      {
        "command": "aiTeam.pauseQueue",
        "title": "%command.pauseQueue%"
      },
      {
        "command": "aiTeam.routing",
        "title": "%command.routing%"
      },
      {
        "command": "aiTeam.accountMenu",
        "title": "%command.accountMenu%"
      },
      {
        "command": "aiTeam.refreshQuota",
        "title": "%command.refreshQuota%"
      },
      {
        "command": "aiTeam.language",
        "title": "%command.language%"
      },
      {
        "command": "aiTeam.setup",
        "title": "%command.setup%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aiTeam.dailyPlan",
        "title": "%command.dailyPlan%"
      },
      {
        "command": "aiTeam.dailyStart",
        "title": "%command.dailyStart%"
      },
      {
        "command": "aiTeam.dailyStop",
        "title": "%command.dailyStop%"
      },
      {
        "command": "aiTeam.dailyTask",
        "title": "%command.dailyTask%"
      },
      {
        "command": "aiTeam.shortcuts",
        "title": "%command.shortcuts%",
        "icon": "$(keyboard)"
      },
      {
        "command": "aiTeam.projects",
        "title": "%command.projects%",
        "icon": "$(project)"
      },
      {
        "command": "aiTeam.connectCli",
        "title": "%command.connectCli%"
      },
      {
        "command": "aiTeam.tryCli",
        "title": "%command.tryCli%"
      },
      {
        "command": "aiTeam.importWorkflow",
        "title": "%command.importWorkflow%"
      },
      {
        "command": "aiTeam.viewWorkflow",
        "title": "%command.viewWorkflow%"
      },
      {
        "command": "aiTeam.clearWorkflow",
        "title": "%command.clearWorkflow%"
      },
      {
        "command": "aiTeam.loginCli",
        "title": "%command.loginCli%"
      },
      {
        "command": "aiTeam.closeBoard",
        "title": "%command.closeBoard%"
      },
      {
        "command": "aiTeam.toggleSidebar",
        "title": "%command.toggleSidebar%"
      },
      {
        "command": "aiTeam.togglePanel",
        "title": "%command.togglePanel%"
      },
      {
        "command": "aiTeam.chat",
        "title": "%command.chat%"
      },
      {
        "command": "aiTeam.installCli",
        "title": "%command.installCli%"
      },
      {
        "command": "aiTeam.checkConnection",
        "title": "%command.checkConnection%"
      },
      {
        "command": "aiTeam.examples",
        "title": "%command.examples%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiTeam",
          "title": "RelayCrew",
          "icon": "media/team.svg"
        }
      ]
    },
    "views": {
      "aiTeam": [
        {
          "id": "aiTeam.dashboard",
          "name": "%view.dashboard%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiTeam.newTask",
          "when": "view == aiTeam.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "aiTeam.setup",
          "when": "view == aiTeam.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "aiTeam.board",
          "when": "view == aiTeam.dashboard",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "RelayCrew",
      "properties": {
        "aiTeam.profiles": {
          "type": "array",
          "scope": "application",
          "default": [
            {
              "id": "codex-main",
              "label": "Codex \u00b7 Main",
              "provider": "codex",
              "executable": "codex",
              "model": "",
              "effort": "medium",
              "env": {},
              "secretEnv": [],
              "modelPolicy": "flagship"
            },
            {
              "id": "claude-main",
              "label": "Claude \u00b7 Main",
              "provider": "claude",
              "executable": "claude",
              "model": "",
              "effort": "medium",
              "env": {},
              "secretEnv": [],
              "modelPolicy": "flagship"
            },
            {
              "id": "gemini-main",
              "label": "Gemini \u00b7 Main",
              "provider": "gemini",
              "executable": "gemini",
              "model": "",
              "env": {},
              "secretEnv": [],
              "modelPolicy": "flagship"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "provider",
              "executable"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude",
                  "gemini",
                  "compatible",
                  "antigravity"
                ]
              },
              "executable": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "secretEnv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "quotaFile": {
                "type": "string",
                "description": "%profile.quotaFile%"
              },
              "modelPolicy": {
                "type": "string",
                "enum": [
                  "flagship",
                  "cli",
                  "custom"
                ],
                "description": "%profile.modelPolicy%"
              },
              "quotaCeiling": {
                "type": "number",
                "minimum": 1,
                "maximum": 100,
                "description": "%profile.quotaCeiling%"
              },
              "hosting": {
                "type": "string",
                "enum": [
                  "cloud",
                  "local"
                ],
                "description": "%profile.hosting%"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "cli",
                  "http"
                ],
                "description": "%profile.transport%"
              },
              "endpoint": {
                "type": "string",
                "description": "%profile.endpoint%"
              }
            },
            "additionalProperties": false
          },
          "description": "%setting.profiles%"
        },
        "aiTeam.autoSwitch": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "%setting.autoSwitch%"
        },
        "aiTeam.quotaThreshold": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 95,
          "description": "%setting.quotaThreshold%"
        },
        "aiTeam.maxChildTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 4,
          "description": "%setting.maxChildTasks%"
        },
        "aiTeam.timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180,
          "default": 30,
          "description": "%setting.timeoutMinutes%"
        },
        "aiTeam.allowEdits": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "%setting.allowEdits%"
        },
        "aiTeam.timezone": {
          "type": "string",
          "default": "",
          "description": "%setting.timezone%"
        },
        "aiTeam.resumeAfterQuota": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "%setting.resumeAfterQuota%"
        },
        "aiTeam.routingMode": {
          "type": "string",
          "scope": "application",
          "enum": [
            "selected",
            "roundRobin"
          ],
          "default": "selected",
          "description": "%setting.routingMode%"
        },
        "aiTeam.rotationPools": {
          "type": "object",
          "scope": "application",
          "default": {
            "builder": [],
            "auditor": [],
            "worker": [],
            "lead": []
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "%setting.rotationPools%"
        },
        "aiTeam.resumeProviderLimited": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "%setting.resumeProviderLimited%"
        },
        "aiTeam.backupBeforeEdits": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%setting.backupBeforeEdits%"
        },
        "aiTeam.backupMaxMB": {
          "type": "integer",
          "scope": "application",
          "default": 100,
          "minimum": 1,
          "maximum": 1024,
          "description": "%setting.backupMaxMB%"
        },
        "aiTeam.backupStorageMB": {
          "type": "integer",
          "scope": "application",
          "default": 2048,
          "minimum": 1,
          "maximum": 102400,
          "description": "%setting.backupStorageMB%"
        },
        "aiTeam.backupExtraPaths": {
          "type": "array",
          "scope": "application",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%setting.backupExtraPaths%"
        },
        "aiTeam.quotaRefreshSeconds": {
          "type": "integer",
          "scope": "application",
          "minimum": 15,
          "maximum": 3600,
          "default": 30,
          "description": "%setting.quotaRefreshSeconds%"
        },
        "aiTeam.language": {
          "type": "string",
          "scope": "application",
          "enum": [
            "auto",
            "en",
            "vi"
          ],
          "default": "auto",
          "description": "%setting.language%"
        },
        "aiTeam.isolateTasks": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%config.isolateTasks%"
        },
        "aiTeam.openTasksInCodex": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%config.openTasksInCodex%"
        }
      }
    },
    "keybindings": [
      {
        "command": "aiTeam.board",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      },
      {
        "command": "aiTeam.chat",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      },
      {
        "command": "aiTeam.newTask",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+shift+n"
      },
      {
        "command": "aiTeam.pauseQueue",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p"
      }
    ]
  },
  "author": "HiTranquility",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiTranquility/RelayCrew.git"
  },
  "homepage": "https://github.com/HiTranquility/RelayCrew#readme",
  "bugs": {
    "url": "https://github.com/HiTranquility/RelayCrew/issues"
  }
}
